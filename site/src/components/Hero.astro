---
import rules from '../generated/rules.json';

const lanes = new Set((rules as { lane: string }[]).map(r => r.lane));
---

<header class="hero">
  <nav class="topbar">
    <p class="wordmark">eventgraph</p>
    <a href="https://github.com/igoriuz/eventgraph">GitHub</a>
  </nav>

  <div class="hero-inner">
    <h1>Find the gaps a review cannot see.</h1>

    <p class="lede">
      eventgraph holds an application's actors, commands, events, read-models
      and screens as a queryable graph instead of a diagram. Then <code>check</code> reports
      the gaps that are structurally impossible to leave open.
    </p>

    <div class="actions">
      <div class="install">
        <code id="install-cmd">npm install -g eventgraph</code>
        <button type="button" id="copy" data-copy="npm install -g eventgraph">Copy</button>
      </div>
      <a class="cta" href="#start">Get started</a>
    </div>

    <dl class="capabilities">
      <div>
        <dt>scaffold</dt>
        <dd>
          Reads real source and writes back the part of the model it can prove —
          screens from file routing, endpoints from route registrations,
          aggregates from table declarations.
        </dd>
      </div>
      <div>
        <dt>check</dt>
        <dd>
          {rules.length} completeness rules in {lanes.size} lanes. Every one of them
          can be told it is wrong, in the model, with a reason.
        </dd>
      </div>
      <div>
        <dt>slice · impact · query</dt>
        <dd>
          Ask about one part — the flow around an event, the blast radius of a
          change — instead of rendering a picture nobody can read.
        </dd>
      </div>
      <div>
        <dt>MCP server</dt>
        <dd>
          The same model for an agent, with writes applied directly or returned
          as a diff to approve, whichever the project sets.
        </dd>
      </div>
    </dl>
  </div>
</header>

<script>
  const button = document.getElementById('copy');
  button?.addEventListener('click', async () => {
    const previous = button.textContent;
    try {
      await navigator.clipboard.writeText(button.dataset.copy ?? '');
      button.textContent = 'Copied';
    } catch {
      // Clipboard access can be refused; say so rather than looking successful.
      button.textContent = 'Select it';
    }
    setTimeout(() => (button.textContent = previous), 1600);
  });
</script>

<style>
  .hero {
    padding-inline: var(--gutter);
    padding-bottom: clamp(2.5rem, 6vw, 4.5rem);
  }

  .topbar {
    max-width: 78rem;
    margin-inline: auto;
    padding-block: 1.35rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--rule);
  }

  .topbar a {
    font-family: var(--mono);
    font-size: 0.8125rem;
    color: var(--ink-soft);
    text-decoration: none;
  }

  .topbar a:hover {
    color: var(--ink);
    text-decoration: underline;
  }

  .wordmark {
    font-family: var(--display);
    font-size: 0.8125rem;
    letter-spacing: 0.02em;
    margin: 0;
  }

  .wordmark::before {
    content: '';
    display: inline-block;
    width: 9px;
    height: 9px;
    margin-right: 0.6rem;
    background: var(--accent-bright);
  }

  .hero-inner {
    max-width: 78rem;
    margin-inline: auto;
    padding-top: clamp(3rem, 8vw, 6rem);
  }

  h1 {
    font-size: clamp(1.85rem, 1.15rem + 3vw, 3.4rem);
    max-width: 20ch;
    margin-bottom: 1.4rem;
  }

  .lede {
    font-size: clamp(1.0625rem, 1rem + 0.45vw, 1.3125rem);
    max-width: 60ch;
    margin-bottom: 2.25rem;
  }

  /* --- install and call to action --- */
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: stretch;
    margin-bottom: clamp(3rem, 7vw, 4.5rem);
  }

  .install {
    display: flex;
    align-items: center;
    gap: 1rem;
    background: var(--wall-raised);
    border: 1px solid var(--rule-strong);
    border-radius: 3px;
    padding: 0.6rem 0.6rem 0.6rem 1rem;
  }

  .install code {
    font-size: 0.875rem;
    white-space: nowrap;
  }

  .install code::before {
    content: '$ ';
    color: var(--accent);
  }

  #copy {
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--ink-soft);
    background: transparent;
    border: 1px solid var(--rule-strong);
    border-radius: 2px;
    padding: 0.3rem 0.6rem;
    cursor: pointer;
  }

  #copy:hover {
    color: var(--ink);
    border-color: var(--ink-soft);
  }

  .cta {
    display: inline-flex;
    align-items: center;
    background: var(--ink);
    color: var(--wall-raised);
    text-decoration: none;
    font-size: 0.9375rem;
    font-weight: 500;
    border-radius: 3px;
    padding: 0.72rem 1.35rem;
  }

  .cta:hover {
    background: #2a2e3c;
  }

  /* --- what it does --- */
  .capabilities {
    display: grid;
    gap: 1.75rem 2.5rem;
    margin: 0;
    padding-top: clamp(1.5rem, 4vw, 2.5rem);
    border-top: 1px solid var(--rule);
  }

  @media (min-width: 44rem) {
    .capabilities {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 72rem) {
    .capabilities {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  dt {
    font-family: var(--mono);
    font-size: 0.8125rem;
    margin-bottom: 0.4rem;
  }

  dd {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--ink-soft);
  }
</style>
