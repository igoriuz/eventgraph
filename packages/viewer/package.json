{
  "name": "@eventgraph/viewer",
  "version": "0.1.0",
  "description": "Renders an eventgraph model as a self-contained interactive HTML page.",
  "keywords": [
    "event-modeling",
    "architecture",
    "graph",
    "visualisation"
  ],
  "homepage": "https://igoriuz.github.io/eventgraph",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/igoriuz/eventgraph.git",
    "directory": "packages/viewer"
  },
  "bugs": "https://github.com/igoriuz/eventgraph/issues",
  "license": "MIT",
  "author": "Igor Kazhdan",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "dist/generate.js",
  "types": "dist/generate.d.ts",
  "exports": {
    ".": {
      "types": "./dist/generate.d.ts",
      "default": "./dist/generate.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && rm -rf dist/templates && cp -r src/templates dist/templates",
    "test": "vitest run"
  },
  "dependencies": {
    "@eventgraph/core": "workspace:*",
    "elkjs": "^0.12.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  }
}
