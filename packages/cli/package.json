{
  "name": "@eventgraph/cli",
  "version": "0.1.0",
  "description": "Model an application as a queryable graph instead of a diagram nobody maintains, and get told which gaps are structurally impossible to leave open.",
  "keywords": [
    "event-modeling",
    "event-sourcing",
    "architecture",
    "ddd",
    "cqrs",
    "graph",
    "cli"
  ],
  "homepage": "https://igoriuz.github.io/eventgraph",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/igoriuz/eventgraph.git",
    "directory": "packages/cli"
  },
  "bugs": "https://github.com/igoriuz/eventgraph/issues",
  "license": "MIT",
  "author": "Igor Kazhdan",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "eventgraph": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && rm -rf dist/presets && cp -r ../../presets dist/presets",
    "test": "vitest run"
  },
  "dependencies": {
    "@eventgraph/core": "workspace:*",
    "@eventgraph/viewer": "workspace:*",
    "commander": "^15.0.0",
    "inquirer": "^14.0.2",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  }
}
